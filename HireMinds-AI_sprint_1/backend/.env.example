# HireMinds AI - Backend Environment Configuration Example
PROJECT_NAME="HireMinds AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hireminds_ai
# Optional direct URL override:
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/hireminds_ai?charset=utf8mb4

# Security (for Phase 3)
# SECRET_KEY=your-super-secret-key-at-least-32-chars-long
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Phase 7: Explainable ATS scoring weights (must sum to 1.0)
# These are initial assumptions, not scientifically validated hiring criteria.
ATS_WEIGHT_SKILL=0.40
ATS_WEIGHT_EXPERIENCE=0.25
ATS_WEIGHT_EDUCATION=0.15
ATS_WEIGHT_PROJECT=0.10
ATS_WEIGHT_SEMANTIC=0.10
ATS_SCORING_VERSION=ats-v1.0

# Phase 8: LLM provider for technical assessment generation
# Supported values: gemini | deepseek
LLM_PROVIDER=gemini

# Gemini provider
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30

# DeepSeek provider (OpenAI-compatible API)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60

ASSESSMENT_PROMPT_VERSION=assessment-v1

# Phase 8: Coding sandbox (DISABLED by default)
# Candidate code is never executed inside the FastAPI process.
# Enable only after configuring a secure Docker sandbox.
CODE_EXECUTION_ENABLED=false
CODE_EXECUTION_BACKEND=disabled
# CODE_EXECUTION_DOCKER_IMAGE=python:3.12-slim
# CODE_EXECUTION_TIMEOUT_SECONDS=10
# CODE_EXECUTION_MEMORY_MB=256
# CODE_EXECUTION_CPU_LIMIT=0.5
# CODE_EXECUTION_PIDS_LIMIT=64
