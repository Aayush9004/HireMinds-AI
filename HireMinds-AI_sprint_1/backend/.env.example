# HireMinds AI - Backend Environment Configuration Example
PROJECT_NAME="HireMinds AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hireminds_ai
# Optional direct URL override:
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/hireminds_ai?charset=utf8mb4

# Security (for Phase 3)
# SECRET_KEY=your-super-secret-key-at-least-32-chars-long
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API (for later phases)
# GEMINI_API_KEY=your_gemini_api_key_here
